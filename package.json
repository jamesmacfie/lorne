{
  "name": "lorne",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "postbuild": "node scripts/build-service-worker.mjs",
    "preview": "vite preview --port 3000",
    "generate-routes": "tsr generate",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lorne-local --local",
    "invite:create": "node scripts/create-invite.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run generate-routes && pnpm run cf-typegen && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler deploy --env staging --var \"BETTER_AUTH_URL:${BETTER_AUTH_URL:?set BETTER_AUTH_URL to the staging origin}\"",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --env production --var \"BETTER_AUTH_URL:${BETTER_AUTH_URL:?set BETTER_AUTH_URL to the production origin}\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.18",
    "@ai-sdk/react": "^4.0.38",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@cloudflare/vite-plugin": "1.46.0",
    "@fontsource-variable/bricolage-grotesque": "5.2.9",
    "@fontsource-variable/geist": "5.2.8",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "ai": "^7.0.35",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "idb": "8.0.3",
    "lucide-react": "1.25.0",
    "openai": "6.48.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.1",
    "workbox-core": "7.4.0",
    "workbox-expiration": "7.4.0",
    "workbox-precaching": "7.4.0",
    "workbox-routing": "7.4.0",
    "workbox-strategies": "7.4.0",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@playwright/test": "1.61.1",
    "@tanstack/router-cli": "1.167.21",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1",
    "wrangler": "4.113.0"
  }
}
